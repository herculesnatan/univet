{
  "name": "petshop-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:staging": "dotenv -e .env.staging -- prisma migrate deploy && dotenv -e .env.staging -- prisma db seed",
    "build:staging": "dotenv -e .env.staging -- next build",
    "start:staging": "dotenv -e .env.staging -- next start -p 3001",
    "tunnel:staging": "npx localtunnel --port 3001 --subdomain univet-staging-qawsed",
    "staging": "npm run db:staging && npm run build:staging && npm run start:staging"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "localtunnel": "^2.0.2",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}