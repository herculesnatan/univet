generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("CLIENTE") // ADMIN, FUNCIONARIO, CLIENTE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client?
  employee  Employee?
  logs      AuditLog[]
}

model Client {
  id          String   @id @default(cuid())
  userId      String   @unique
  cpf         String?  @unique
  phone       String?
  whatsapp    String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pets        Pet[]
}

model Employee {
  id          String   @id @default(cuid())
  userId      String   @unique
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  services    Service[]
}

model Pet {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  species     String
  breed       String?
  sex         String   @default("NAO_INFORMADO")
  weight      Float?
  size        String   // PEQUENO, MEDIO, GRANDE, GIGANTE
  color       String?
  photoUrl    String?
  birthDate   DateTime?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  recurrences  Recurrence[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  durationMin Int
  size        String?  // Aplicável a qual porte? (opicional)
  species     String?  // Aplicável a qual espécie? (opcional)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments          Appointment[]
  appointmentServices   Appointment[] @relation("AppointmentServices")
  recurrences           Recurrence[]
  employees             Employee[]
}

model Appointment {
  id          String   @id @default(cuid())
  petId       String
  serviceId   String?  // Optional para legado/migração
  employeeId  String
  startTime   DateTime
  endTime     DateTime
  status      String   @default("AGENDADO") // AGENDADO, CONFIRMADO, EM_ATENDIMENTO, FINALIZADO, CANCELADO, FALTA
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pet         Pet      @relation(fields: [petId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id]) // Relacionamento antigo preservado para migração
  services    Service[] @relation("AppointmentServices")
  employee    Employee @relation(fields: [employeeId], references: [id])
  payment     Payment?
}

model Payment {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  amount        Float
  discount      Float    @default(0)
  finalAmount   Float
  method        String?  // PIX, CARTAO_CREDITO, CARTAO_DEBITO, DINHEIRO
  status        String   @default("PENDENTE") // PENDENTE, PAGO, CANCELADO
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Recurrence {
  id          String   @id @default(cuid())
  petId       String
  serviceId   String
  interval    String   // SEMANAL, QUINZENAL, MENSAL
  nextDate    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
